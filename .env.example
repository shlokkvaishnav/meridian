# Copy this file to .env and fill in the values.
# See src/lib/env.ts for validation rules.

# ---- Required ----

# PostgreSQL connection string (Supabase recommended).
DATABASE_URL="postgresql://user:password@host:5432/database"

# 32-byte key, base64-encoded, used to encrypt GitHub tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Public URL the app is served from (used for absolute links, robots.txt, sitemap.xml).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Required in production, optional in development ----

# Protects GET /api/cron/sync — sent as "Authorization: Bearer <CRON_SECRET>" by your scheduler.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Verifies GitHub webhook payload signatures for POST /api/webhooks/github.
# Must match the secret configured on the GitHub repo/org webhook.
GITHUB_WEBHOOK_SECRET=""

# ---- Optional ----

# Enables Claude-powered PR analysis, work summaries, and strategic insights.
# Without it, the deterministic rule-based insight engine still works.
ANTHROPIC_API_KEY=""

# Enables realtime dashboard updates via Supabase's Postgres change feed.
# Without these, the dashboard still works but requires a manual refresh/sync.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
